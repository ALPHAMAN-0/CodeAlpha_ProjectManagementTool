# Required in production. In development these all have safe defaults.

# MongoDB connection string. If omitted in development, the server boots a local
# mongod via mongodb-memory-server and persists data to .data/mongo.
MONGODB_URI=

# Must be at least 32 characters. Required in production; a loud dev-only
# fallback is used when unset outside production.
JWT_SECRET=

PORT=4000
NODE_ENV=development
COOKIE_NAME=pm_token
JWT_EXPIRES_IN=7d
